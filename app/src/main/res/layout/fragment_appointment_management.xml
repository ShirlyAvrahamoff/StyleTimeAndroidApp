<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:padding="16dp">

    <!-- Main CardView -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        android:background="@android:color/white"
        android:alpha="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Page Title -->
            <TextView
                android:id="@+id/futureAppointmentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Future Appointments"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_color"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <!-- RadioGroup for Filter -->
            <RadioGroup
                android:id="@+id/radioGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/radioAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:checked="true"
                    app:buttonTint="@color/pink" />

                <RadioButton
                    android:id="@+id/radioClient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Client"
                    android:layout_marginStart="16dp"
                    app:buttonTint="@color/pink" />

                <RadioButton
                    android:id="@+id/radioTreatment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Treatment"
                    android:layout_marginStart="16dp"
                    app:buttonTint="@color/pink" />
            </RadioGroup>

            <!-- Spinner for Client -->
            <Spinner
                android:id="@+id/spinnerClient"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:visibility="gone"
                android:background="@drawable/spinner_background"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <!-- Spinner for Treatment -->
            <Spinner
                android:id="@+id/spinnerTreatment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:visibility="gone"
                android:background="@drawable/spinner_background"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <!-- Empty State Text -->
            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No appointments found"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="@android:color/darker_gray"
                android:background="#EEEEEE"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- RecyclerView for Appointments -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appointmentsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- View Passed Appointments Button (Inside CardView) -->
            <Button
                android:id="@+id/btnViewPassedAppointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Passed Appointments"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/pink"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
